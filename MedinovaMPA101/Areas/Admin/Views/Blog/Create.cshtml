@using MedinovaMPA101.ViewModels.BlogViewModels

@model BlogCreateVM
<div class="container">
    <div class="row">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-group">
                <label asp-for="Image">Image</label>
                <input asp-for="Image" class="form-control" placeholder="Enter Image">
                <span asp-validation-for="Image"></span>
            </div>
            <div class="form-group">
                <label asp-for="Text">Text</label>
                <input asp-for="Text" class="form-control" placeholder="Enter Text">
                <span asp-validation-for="Text"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Description</label>
                <input asp-for="Description" class="form-control" placeholder="Enter Description">
                <span asp-validation-for="Description"></span>
            </div>

            <div class="form-group">
               <select asp-for="TeamId" asp-items="@ViewBag.Teams">

               </select>
                <span asp-validation-for="TeamId"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>
